DATABASE_URL=postgresql+psycopg://devmatch:devmatch@localhost:5432/devmatch
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:5173
VITE_API_URL=

# Social login (Google / GitHub / LinkedIn). Leave blank to disable a provider.
# Register this redirect URI in each provider console: ${FRONTEND_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH_STATE_EXPIRE_MINUTES=10

# Scale / hardening
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RECOMMENDATION_CACHE_TTL_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
UVICORN_WORKERS=2
API_PORT=8000
POSTGRES_PORT=5432
